# Public browser code is not used. Do not add Supabase service keys here.
# Configure these values in Vercel after creating the Supabase project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
